{
    // See https://go.microsoft.com/fwlink/?LinkId=733558
    // for the documentation about the tasks.json format
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Configure",
            "type": "shell",
            "command": "cmake",
            "args": [
                "-S${workspaceFolder}",
                "-B${workspaceFolder}/build/",
                "-DCMAKE_BUILD_TYPE=Debug",
            ]
        },
        {
            "label": "Build",
            "type": "shell",
            "command": "cmake --build ${workspaceFolder}/build --parallel 8",
            "dependsOn": "Configure",
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ]
}